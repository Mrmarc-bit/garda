{
  "name": "garda-sim-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@garda-sim/web run dev",
    "api": "PYTHONPATH=. ./apps/api/.venv/bin/uvicorn apps.api.src.main:app --port 8000 --host 127.0.0.1 --reload",
    "build": "npm --workspace=@garda-sim/web run build",
    "start": "npm --workspace=@garda-sim/web run start",
    "lint": "npm --workspace=@garda-sim/web run lint",
    "typecheck": "npm --workspace=@garda-sim/web run typecheck",
    "test:api": "PYTHONPATH=. ./apps/api/.venv/bin/pytest apps/api/tests",
    "test": "npm run typecheck && npm run test:api"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^7.1.7"
  }
}
