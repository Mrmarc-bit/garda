# GARDA-SIM API configuration.
#
# Copy to .env and adjust for your environment. The API does not load .env
# automatically; export the variables (or use your process manager) so that
# `npm run api` inherits them.
#
# Never commit a filled-in .env. .gitignore already covers .env*.

# development | production
# production disables /docs, /redoc and /openapi.json, refuses to generate demo
# credentials, and marks the session cookie Secure.
GARDA_ENV=development

# Private (0700) directory for the SQLite ledger, the audit HMAC key and the
# generated demo credentials. Defaults to <repo>/.garda
# GARDA_DATA_DIR=/absolute/path/to/data

# Password for the three seeded demo operators. When unset in development a
# random password is generated once into <data>/demo-credentials.txt.
# Required when GARDA_ENV=production.
# GARDA_DEMO_PASSWORD=

# HMAC key for the append-only ledger chain. When unset, a 32-byte key is
# generated once into <data>/audit-secret.key with 0600 permissions.
# GARDA_AUDIT_SECRET=

# Session lifetime in minutes.
GARDA_SESSION_TTL_MINUTES=480

# Mark the session cookie Secure. Defaults to true when GARDA_ENV=production.
# GARDA_SESSION_COOKIE_SECURE=false

# Minimum operator clearance required to run a simulation or record a review.
GARDA_MIN_CLEARANCE=2

# Server-side SEC-OT-04 policy. Set to false only for a deliberate permissive
# demonstration; the settings page shows a warning when this is off.
GARDA_STRICT_OT_MODE=true

# Comma-separated browser origins allowed to call the API directly.
GARDA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# In-process fixed-window rate limit. Replace with a shared store before running
# more than one worker, because per-process counters do not compose.
GARDA_RATE_LIMIT_MAX_REQUESTS=60
GARDA_RATE_LIMIT_WINDOW_SECONDS=60

# Upper bound for paged ledger reads.
GARDA_MAX_PAGE_SIZE=200

# Password hashing cost (stdlib PBKDF2-SHA256).
GARDA_PBKDF2_ITERATIONS=210000

# Web client: leave empty to use the same origin through the Next.js rewrite.
# Set only when the API is served from a different origin.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
